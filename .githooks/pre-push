#!/usr/bin/env bash
set -euo pipefail

week=$(date +%G%V)
status=0
while read -r _ local_oid remote_ref remote_oid; do
	[[ $remote_ref == refs/tags/* && $remote_oid =~ ^0+$ && ! $local_oid =~ ^0+$ ]] || continue
	tag=${remote_ref#refs/tags/}
	if [[ ! $tag =~ ^[0-9]+\.[0-9]+\.[0-9]+-dd\.$week(\.[1-9][0-9]*)?$ ]]; then
		echo "pre-push: tag '$tag' does not match X.Y.Z-dd.$week(.<int>)?" >&2
		status=1
	fi
done
exit $status
